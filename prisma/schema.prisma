// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // 6.x 支持在这里直接引用变量
}

// モデル定義（ここは変更なし）
model Workout {
  id        Int          @id @default(autoincrement())
  date      String
  exercise  String
  notes     String?      @db.Text
  sets      WorkoutSet[]
  createdAt DateTime     @default(now())
}

model WorkoutSet {
  id        Int     @id @default(autoincrement())
  workoutId Int
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  setIndex  Int
  weight    Float
  reps      Int
}